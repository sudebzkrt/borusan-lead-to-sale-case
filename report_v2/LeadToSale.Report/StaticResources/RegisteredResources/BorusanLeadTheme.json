{
  "name": "BorusanLeadTheme",
  "dataColors": [
    "#1C5CAB",
    "#EB6834",
    "#1BAF7A",
    "#EDA100",
    "#4A3AA7",
    "#8DA2BD",
    "#D03B3B",
    "#0CA30C"
  ],
  "background": "#FFFFFF",
  "foreground": "#1B1F27",
  "tableAccent": "#1C5CAB",
  "good": "#0CA30C",
  "neutral": "#8DA2BD",
  "bad": "#D03B3B",
  "maximum": "#1C5CAB",
  "center": "#3987E5",
  "minimum": "#86B6EF",
  "null": "#B9C2CE",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1B1F27"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#5B6472"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 22,
      "color": "#1B1F27"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#1B1F27"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "alignment": "left",
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#1B1F27"
              }
            },
            "titleWrap": true
          }
        ],
        "subTitle": [
          {
            "alignment": "left",
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "fontColor": {
              "solid": {
                "color": "#8A93A1"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "radius": 8,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 10,
            "bottom": 10,
            "left": 12,
            "right": 12
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": false,
            "labelColor": {
              "solid": {
                "color": "#5B6472"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#EEF0F3"
              }
            },
            "gridlineStyle": "solid",
            "gridlineThickness": 1,
            "labelColor": {
              "solid": {
                "color": "#8A93A1"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "position": "Bottom",
            "showTitle": false,
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#5B6472"
              }
            }
          }
        ],
        "labels": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#5B6472"
              }
            }
          }
        ],
        "dataPoint": [
          {
            "borderShow": false
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 2,
            "lineChartType": "straight",
            "showMarker": false
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0,
            "border": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F4F6"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F3F4F6"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "radius": 6,
            "width": 1
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#5B6472"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1B1F27"
              }
            },
            "fontSize": 9.5,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    }
  }
}